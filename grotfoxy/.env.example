# Copy to `.env` and edit. Every value here is optional.

# Bind 0.0.0.0 so your phone on the same Wi-Fi can reach the Den Computer.
# Use 127.0.0.1 to keep GrotFoxy to this machine only.
GROTFOXY_HOST=0.0.0.0
GROTFOXY_PORT=8787

# Encrypts provider API keys at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you leave this unset, a key is generated into data/master.key instead.
# Changing it makes previously stored keys unreadable.
# GROTFOXY_SECRET=

# GROTFOXY_DATA_DIR=./data
# GROTFOXY_WORKSPACE_DIR=./workspace

# How many runs may execute at once.
# GROTFOXY_MAX_CONCURRENT_RUNS=3

# Set false to stop cron schedules from firing on this instance.
# GROTFOXY_SCHEDULER=true

# Set false once your owner account exists, so nobody else can claim the box.
# GROTFOXY_ALLOW_SETUP=true

# debug | info | warn | error
GROTFOXY_LOG_LEVEL=info
